# CivicPulse AI Environment Variables

# App Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=civicpulse-secret-key-change-in-production-brics-2026

# Database (PostgreSQL + PostGIS + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicpulse_db

# AI Provider Configuration (Default: Gemini / Google)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=gemini
DEFAULT_SPEECH_PROVIDER=google

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_credentials.json

# Secondary / Sovereign LLM Provider Fallbacks (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Messaging Channel Webhook Sandboxes (WhatsApp / SMS / Telegram)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
MESSAGING_WEBHOOK_SECRET=civicpulse_webhook_secret_key

# Async Processing (Redis / Celery)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Abuse Defense
MAX_SUBMISSIONS_PER_HOUR=10
DUPLICATE_SIMILARITY_THRESHOLD=0.95
